{
  "name": "pdf-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local, offline PDF editor powered by MuPDF (WASM)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview --open",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "comlink": "^4.4.2",
    "mupdf": "^1.28.6",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
